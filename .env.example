# ─────────────────────────────────────────────────────────────
# ASTRAE — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA use o prefixo NEXT_PUBLIC_ em chaves secretas.
# ─────────────────────────────────────────────────────────────

# NASA Open APIs (APOD). Gere a sua em https://api.nasa.gov
# Sem chave, o backend usa DEMO_KEY (limite baixo por IP).
NASA_API_KEY=

# NOAA NCEI Climate Data Online (token gratuito):
# https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_KEY=

# Supabase (autenticação + banco PostgreSQL)
# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (cache persistente de APIs). Opcional.
SUPABASE_SERVICE_ROLE_KEY=

# Identificação enviada ao serviço de geocodificação (Nominatim/OSM),
# exigida pela política de uso deles. Use um e-mail ou URL de contato.
GEOCODER_CONTACT=

# ASTRAE AI — escolha um provedor (ou os dois)
# Gratuito: Google Gemini — crie a chave em https://aistudio.google.com
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.8-flash (ver https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# Pago por uso: Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5 (ver https://platform.claude.com/docs/en/models/overview)
ANTHROPIC_MODEL=
# Com as duas chaves: "gemini" ou "anthropic" (padrão: gemini)
AI_PROVIDER=
